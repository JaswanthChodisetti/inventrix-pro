# MongoDB Atlas connection string (required)
# Get it from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inventrix_pro

# App URL for password reset emails (optional, Vercel URL works too)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Gmail SMTP for password reset emails (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
